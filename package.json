{
  "name": "exphono",
  "version": "0.4.0",
  "description": "Run your Express app on Hono. A migration-first Express compatibility layer for Node.js, Cloudflare Workers, Deno and Bun.",
  "keywords": [
    "express",
    "hono",
    "migration",
    "compatibility",
    "express-compat",
    "node",
    "cloudflare-workers",
    "deno",
    "bun",
    "edge"
  ],
  "homepage": "https://github.com/otnc/exphono#readme",
  "bugs": {
    "url": "https://github.com/otnc/exphono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/exphono.git"
  },
  "license": "MIT",
  "author": "otoneko.",
  "type": "module",
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "workerd": "./dist/edge/index.mjs",
      "deno": "./dist/edge/index.mjs",
      "bun": "./dist/node/index.mjs",
      "node": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.cjs"
      },
      "default": "./dist/edge/index.mjs"
    },
    "./package.json": "./package.json",
    "./v4": {
      "types": "./dist/v4.d.ts",
      "workerd": "./dist/edge/v4.mjs",
      "deno": "./dist/edge/v4.mjs",
      "bun": "./dist/node/v4.mjs",
      "node": {
        "import": "./dist/node/v4.mjs",
        "require": "./dist/node/v4.cjs"
      },
      "default": "./dist/edge/v4.mjs"
    },
    "./v5": {
      "types": "./dist/v5.d.ts",
      "workerd": "./dist/edge/v5.mjs",
      "deno": "./dist/edge/v5.mjs",
      "bun": "./dist/node/v5.mjs",
      "node": {
        "import": "./dist/node/v5.mjs",
        "require": "./dist/node/v5.cjs"
      },
      "default": "./dist/edge/v5.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown && node scripts/postbuild.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check --write",
    "ci": "biome ci",
    "prepublishOnly": "pnpm run build",
    "test:express": "node test/express-suite/run.js",
    "test:express:update": "node test/express-suite/run.js --update"
  },
  "peerDependencies": {
    "@types/node": "*",
    "hono": "^4"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "after": "^0.8.2",
    "cookie-parser": "^1.4.7",
    "cookie-signature": "^1.2.2",
    "ejs": "^6.0.1",
    "exphono": "link:",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.2",
    "hono": "^4.13.7",
    "methods": "^1.1.2",
    "miniflare": "^4.20260730.0",
    "mocha": "^12.0.0",
    "on-finished": "^2.4.1",
    "rolldown": "^1.2.7",
    "safe-buffer": "^5.2.1",
    "supertest": "^6.3.4",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "utils-merge": "^1.0.1",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "workerd"
    ]
  }
}
